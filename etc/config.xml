<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <waiter24_export>
            <general>
                <!-- Local testing defaults (OSPanel dev host). For production set these
                     to https://waiter24.ai/... or just override them per store in the admin. -->
                <endpoint_url>http://waiter.loc/api/integrations/menu</endpoint_url>
                <widget_url>http://waiter.loc/widget.js</widget_url>
            </general>
            <export>
                <simple_stock_mode>1</simple_stock_mode>
            </export>
            <widget>
                <enabled>0</enabled>
                <demo_mode>0</demo_mode>
            </widget>
        </waiter24_export>
    </default>
</config>
